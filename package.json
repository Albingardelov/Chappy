{
  "name": "chappy",
  "version": "1.0.0",
  "type": "module",
  "description": "Fullstack chatt-app-Chappy",
  "main": "distServer/server.js",
  "scripts": {
    "build-server": "tsc -p ./srcServer/tsconfig.json",
    "start-server": "node --env-file .env ./distServer/server.js",
    "restart-server": "npm run build-server && npm run start-server",
    "dev": "vite",
    "build-frontend": "tsc -b && vite build",
    "predeploy": "npm run build-frontend && npm run build-server",
    "start": "node --env-file .env ./distServer/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.920.0",
    "@aws-sdk/lib-dynamodb": "^3.920.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
